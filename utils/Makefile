# Makefile — Local Encrypted Message Tool
# Works on Linux, macOS, and Windows (via Git Bash — see README.md)

# On Windows "python" usually exists, on Linux/macOS it's often "python3"
PYTHON := $(shell command -v python3 2> /dev/null || command -v python 2> /dev/null)
APP_NAME := EncryptedMessageTool
ENTRY := crypto_app.py

.PHONY: help install run build clean

help:
	@echo "Available targets:"
	@echo "  make install   -> install dependencies (pip)"
	@echo "  make run       -> run the application in dev mode (window)"
	@echo "  make build     -> generate a standalone executable (dist/ folder)"
	@echo "  make clean     -> remove files generated by build"

install:
	@echo "Installing dependencies..."
	$(PYTHON) -m pip install --upgrade pip
	$(PYTHON) -m pip install -r requirements.txt

run:
	@echo "Launching the application..."
	$(PYTHON) $(ENTRY)

build:
	@echo "Installing PyInstaller..."
	$(PYTHON) -m pip install pyinstaller
	@echo "Building the executable..."
	$(PYTHON) -m PyInstaller --onefile --windowed --name "$(APP_NAME)" $(ENTRY)
	@echo "Done. Executable available in dist/"

clean:
	@echo "Cleaning up..."
	rm -rf build dist __pycache__ *.spec
